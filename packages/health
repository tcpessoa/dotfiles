#!/bin/bash
# Sanity-check that the tools packages/install manages are actually on PATH.
# Exits non-zero when anything is missing, so packages/install can report it.

# "<label>:<version command>" — the probed binary is the command's first word.
checks=(
    "fzf:fzf --version"
    "jq:jq --version"
    "ripgrep:rg --version"
    "fd:fd --version"
    "bat:bat --version"
    "kubectl:kubectl version --client"
    "docker:docker --version"
    "delta:delta --version"
    "eza:eza --version"
    "node:node --version"
    "npm:npm --version"
    "bun:bun --version"
    "starship:starship --version"
    # stow is what setup/sync-stow hard-depends on — missing it fails the *next*
    # step of ./install, so name it here rather than one stage later.
    "stow:stow --version"
)

missing_tools=()

for entry in "${checks[@]}"; do
    label="${entry%%:*}"
    cmd="${entry#*:}"
    bin="${cmd%% *}"
    echo -n "Checking for $label..."
    if command -v "$bin" > /dev/null; then
        echo " FOUND: $($cmd 2>/dev/null | head -1)"
    else
        echo " NOT FOUND"
        missing_tools+=("$label")
    fi
done

echo -n "Checking for nvm..."
# nvm lives in NVM_DIR, which init.zsh and packages/install both set to
# $XDG_DATA_HOME/nvm — not the installer's ~/.nvm default.
NVM_DIR="${NVM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    source "$NVM_DIR/nvm.sh"
    echo " FOUND: $(nvm --version)"
else
    echo " NOT FOUND"
    missing_tools+=("nvm")
fi

echo -e "\n---> Check for [kubectx] manually, it doesn't have a version command"

if [ ${#missing_tools[@]} -gt 0 ]; then
    echo "The following tools are missing: ${missing_tools[*]}"
    echo "Please install them to ensure proper functionality."
    exit 1
fi
echo "All tools are installed and ready."
