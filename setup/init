#!/usr/bin/env bash
# Pre-clone bootstrap. This is the ONE command you run on a bare machine:
#
#   curl -fsSL https://raw.githubusercontent.com/tcpessoa/dotfiles/main/setup/init | bash
#
# It owns everything that must happen before the repo can exist — Xcode CLT,
# Homebrew, git, the clone itself — and then hands over to ./install.
# Self-contained on purpose: it cannot source setup/lib.sh, because at the point
# it starts running there is no repo to source it from. Keep it bash 3.2 clean
# (that is what /bin/bash is on a stock macOS).
set -euo pipefail

REPO_URL="${DOTFILES_REPO:-https://github.com/tcpessoa/dotfiles.git}"
DEST_DEFAULT="${DOTFILES_DIR:-$HOME/dotfiles}"

say()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m ! \033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m x \033[0m %s\n' "$*" >&2; exit 1; }

interactive() {
  [ "${DOTFILES_YES:-}" = "1" ] && return 1
  [ -r /dev/tty ] && [ -w /dev/tty ]
}

ask() {
  prompt="$1"; default="${2:-}"
  if ! interactive; then echo "$default"; return 0; fi
  printf '\033[1;36m ? \033[0m %s [\033[1m%s\033[0m]: ' "$prompt" "$default" >/dev/tty
  IFS= read -r reply </dev/tty || reply=""
  [ -n "$reply" ] && echo "$reply" || echo "$default"
}

[ "$(uname -s)" = "Darwin" ] || die "setup/init currently only handles macOS. On Linux, clone the repo and run ./install."

say "Provisioning this machine from $REPO_URL"

# Ask for sudo once, up front, and keep it warm for the whole run.
if interactive; then
  sudo -v </dev/tty || die "sudo is required."
  # `|| true`: this subshell inherits errexit, and one transient sudo failure
  # would otherwise end the keepalive silently for the whole run.
  ( while true; do sudo -n true || true; sleep 50; kill -0 "$$" 2>/dev/null || exit; done ) 2>/dev/null &
fi

# 1. Xcode Command Line Tools — this is where `git` comes from.
if ! xcode-select -p >/dev/null 2>&1; then
  # The CLT installer is a GUI dialog; with no TTY there is nobody to accept it
  # and the wait below would spin forever.
  [ -r /dev/tty ] || die "Xcode Command Line Tools are missing and there is no TTY. Run 'xcode-select --install' first, then re-run."
  say "Installing Xcode Command Line Tools (accept the dialog that just opened)"
  xcode-select --install >/dev/null 2>&1 || true
  until xcode-select -p >/dev/null 2>&1; do sleep 5; done
  say "Xcode Command Line Tools ready"
fi

# 2. Homebrew. NONINTERACTIVE skips its "press RETURN" prompt, which cannot be
#    answered when this script is itself arriving on stdin from curl.
if ! command -v brew >/dev/null 2>&1; then
  say "Installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# 3. Put brew on PATH for THIS process — the installer only prints this line.
for prefix in /opt/homebrew /usr/local; do
  if [ -x "$prefix/bin/brew" ]; then eval "$("$prefix/bin/brew" shellenv)"; break; fi
done
command -v brew >/dev/null 2>&1 || die "Homebrew installed but 'brew' is still not on PATH."

# 4. Clone over HTTPS. The repo is public, so this needs no credentials at all —
#    no SSH key, no gh login. Upgrading origin to SSH happens later, in
#    setup/postinstall, once there is a keychain and a gh session to do it with.
DEST="$(ask "Clone dotfiles to" "$DEST_DEFAULT")"
if [ -d "$DEST/.git" ]; then
  say "Repo already at $DEST — leaving it alone"
else
  [ -e "$DEST" ] && die "$DEST exists but is not a git repo. Move it aside and re-run."
  say "Cloning into $DEST"
  git clone "$REPO_URL" "$DEST"
fi

# 5. Hand over. exec so ./install owns the terminal (and the warm sudo ticket).
say "Handing over to ./install"
cd "$DEST"
exec ./install
