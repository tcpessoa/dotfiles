[user]
    name = Tiago Pessoa
    email = 70546713+tcpessoa@users.noreply.github.com

# Work-specific overrides (email, ssh key, `work:` clone shorthand) for
# anything under ~/work/. See ~/.config/git/config-work-template.
[includeIf "gitdir/i:~/work/"]
  path = ~/.config/git/config-work

[init]
    defaultBranch = main

[core]
    # sshCommand = ssh -i ~/.ssh/id_ed25519_pers
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[pull]
    rebase = true

[push]
    default = current  # Push only the current branch by default
    autoSetupRemote = true

[url "git@github.com:tcpessoa/"]
    insteadOf = mygh:

# gh as the credential helper for HTTPS github remotes. Committed here (rather
# than written by `gh auth setup-git` in postinstall) because ~/.config/git/config
# is a stowed symlink into this repo — a `git config --global` write would dirty
# the tracked file. The blank helper resets any system-level helpers first.
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
