#!/usr/bin/env bash
# Single entrypoint for provisioning a machine from this repo.
#
# On a bare machine you don't run this directly — you run setup/init, which
# installs Xcode CLT + Homebrew, clones the repo, and then execs this.
#
# Order matters: bootstrap installs prerequisites (incl. brew), packages installs
# the CLI tools (incl. `stow` itself), sync-stow creates the symlinks, and only
# then can postinstall use the tools and configs both being in place.
# Every step is idempotent and safe to re-run on its own.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/setup/lib.sh"

say "[1/4] bootstrap"
"$SCRIPT_DIR/setup/bootstrap"

# The Homebrew installer only *prints* its shellenv line; it does not run it. Without
# this, packages/install would run with no `brew` on PATH on a fresh machine and
# silently fail every single package.
dotfiles_brew_shellenv || die "Homebrew is not on PATH after bootstrap."

say "[2/4] packages"
"$SCRIPT_DIR/packages/install"

say "[3/4] stow"
"$SCRIPT_DIR/setup/sync-stow"

say "[4/4] post-install"
"$SCRIPT_DIR/setup/postinstall"

say "✅ Done. Restart your terminal for all changes to take effect."
