#!/usr/bin/env bash
# Drive the tmux window name + agent state from Claude Code hook events.
#
#   claude-tmux-title working   # UserPromptSubmit: name window, state running
#   claude-tmux-title run       # PostToolUse: state running (clears ⏸ after a permission)
#   claude-tmux-title notify    # Notification: state paused (needs your input)
#   claude-tmux-title done      # Stop: refresh name, state done (your turn)
#   claude-tmux-title clear     # SessionEnd: drop state, hand naming back to tmux
#
# The window name is the session title: /rename (custom-title) > Claude's auto
# title (ai-title) > the prompt. The ▶/⏸/✓ glyph and tab color come from @agent in
# the theme, so the name itself stays clean.
#
# Reads the hook's JSON payload on stdin. No-ops cleanly when not inside tmux.
# Prints nothing to stdout (UserPromptSubmit would otherwise inject it as context).

mode="$1"
max=24   # keep tabs short; longer titles get an ellipsis

# Always drain stdin so Claude's hook pipe never blocks.
input="$(cat)"

# Outside tmux there's nothing to rename.
[ -z "$TMUX" ] && exit 0

j() { printf '%s' "$input" | jq -r "$1 // empty" 2>/dev/null; }

# Record agent state + its tab color as per-window options (one tmux call: this
# runs on every tool use).
set_state() {
  local color=""
  case "$1" in
    running) color="#E6C384" ;;  # yellow — working
    paused)  color="#E46876" ;;  # red    — needs you
    done)    color="#98BB6C" ;;  # green  — your turn
  esac
  tmux set-option -w -t "$TMUX_PANE" @agent "$1" \; \
       set-option -w -t "$TMUX_PANE" @agent_color "$color" 2>/dev/null
}

# Session title from the transcript. Claude rewrites these lines through the
# session, so the last one is current; a /rename beats the auto title.
# A full scan of a large (~13MB) transcript is ~50-90ms, so only call this at turn
# boundaries, never per tool use.
transcript_title() {
  local t lines v
  t="$(j .transcript_path)"
  [ -f "$t" ] || return
  lines="$(grep -E '^\{"type":"(custom|ai)-title"' -- "$t")"
  v="$(printf '%s\n' "$lines" | grep '"custom-title"' | tail -1 | jq -r '.customTitle // empty' 2>/dev/null)"
  [ -z "$v" ] && v="$(printf '%s\n' "$lines" | grep '"ai-title"' | tail -1 | jq -r '.aiTitle // empty' 2>/dev/null)"
  printf '%s' "$v"
}

# Squash whitespace, truncate, rename. Empty input leaves the name alone.
name_window() {
  local title
  title="$(printf '%s' "$1" | tr '\n\t' '  ' | tr -s ' ' | sed 's/^ *//; s/ *$//')"
  [ -z "$title" ] && return
  if [ "${#title}" -gt "$max" ]; then
    title="$(printf '%s' "$title" | cut -c1-"$max" | sed 's/ *$//')…"
  fi
  tmux rename-window -t "$TMUX_PANE" "$title" 2>/dev/null
}

case "$mode" in
  working)
    # first prompt has no title yet -> fall back to the prompt text
    title="$(transcript_title)"
    [ -z "$title" ] && title="$(j .prompt)"
    name_window "$title"
    set_state running
    ;;
  run)
    set_state running
    ;;
  notify)
    set_state paused
    ;;
  done)
    # picks up the auto title once generated, and any /rename since the last turn
    name_window "$(transcript_title)"
    set_state done
    ;;
  clear)
    # session ended -> drop state so the cross-session roll-up stops counting it,
    # and let tmux auto-name the window again.
    tmux set-option -uw -t "$TMUX_PANE" @agent 2>/dev/null
    tmux set-option -uw -t "$TMUX_PANE" @agent_color 2>/dev/null
    tmux set-window-option -t "$TMUX_PANE" automatic-rename on 2>/dev/null
    ;;
esac

exit 0
