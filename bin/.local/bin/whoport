#!/usr/bin/env bash
# whoport            one line per listening TCP port you own
# whoport PORT...    who is responsible for each port, in detail
set -uo pipefail

case "${1:-}" in -h|--help) sed -n '2,3s/^# //p' "$0"; exit 0 ;; esac

b=""; d=""; r=""
if [ -t 1 ]; then b=$(tput bold 2>/dev/null); d=$(tput dim 2>/dev/null); r=$(tput sgr0 2>/dev/null); fi

row() { [ -n "$2" ] && printf '  %s%-10s%s %s\n' "$d" "$1" "$r" "$2"; }

cwd_of() { lsof -w -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1; }

repo_of() {
  local dir=$1 top branch
  [ -d "$dir" ] || return
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || return
  branch=$(git -C "$top" branch --show-current 2>/dev/null)
  echo "$top${branch:+ ($branch)}"
}

package_of() {
  local dir=$1
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    if [ -f "$dir/package.json" ]; then
      local name
      name=$(sed -n 's/^[[:space:]]*"name":[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/package.json" | head -1)
      echo "${name:-?}  $dir/package.json"
      return
    fi
    dir=$(dirname "$dir")
  done
}

# First non-flag argument after the interpreter, skipping values of flags that take one.
script_of() {
  local skip=0 first=1 a
  for a in $1; do
    if [ $first -eq 1 ]; then first=0; continue; fi
    if [ $skip -eq 1 ]; then skip=0; continue; fi
    case $a in
      -r|--require|--import|--loader|--experimental-loader|-e|--eval|--env-file|--inspect-port) skip=1 ;;
      -*) ;;
      *) echo "$a"; return ;;
    esac
  done
}

# Path tokens shortened to their basename and --flag=value tokens dropped,
# so "node --env-file=x /…/bin/pnpm dev" reads "node pnpm dev".
short() { echo "$1" | sed -E 's#(^| )--[^ =]+=[^ ]*#\1#g; s#(^| )\.{0,2}/[^ ]*/#\1#g; s/  +/ /g' | cut -c1-80; }

# Walks up to the shell or launchd. Sets CHAIN, ORPHANED and LAUNCHER_CWD
# (the cwd of the topmost non-shell ancestor).
ancestry() {
  local pid=$1 ppid n=0 top=$1
  CHAIN=""; ORPHANED=0
  while [ "$pid" -gt 1 ] && [ $n -lt 10 ]; do
    case $(ps -o comm= -p "$pid" 2>/dev/null) in
      *zsh|*bash|*fish|-*sh|*/sh|sh|*tmux*|*login|*sshd*|*Terminal*|*iTerm*|*Code*|*Cursor*)
        local sh; sh=$(ps -o comm= -p "$pid"); CHAIN="${sh##*/}${CHAIN:+  →  $CHAIN}"; break ;;
    esac
    CHAIN="$(short "$(ps -o command= -p "$pid" 2>/dev/null)")${CHAIN:+  →  $CHAIN}"
    top=$pid
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [ -z "$ppid" ] && break
    [ "$ppid" -eq 1 ] && ORPHANED=1
    pid=$ppid; n=$((n + 1))
  done
  LAUNCHER_CWD=$(cwd_of "$top")
}

# Sets CWD, and ORIGIN: the directory that says where the process comes from.
# Daemons chdir to /, so their launcher's cwd stands in.
locate() {
  CWD=$(cwd_of "$1")
  ancestry "$1"
  ORIGIN=$CWD
  [ "$ORIGIN" = "/" ] && ORIGIN=${LAUNCHER_CWD:-/}
}

is_docker_forwarder() {
  case "$1" in
    *lima*|*[Dd]ocker*|*vpnkit*|*[Oo]rb[Ss]tack*|*gvproxy*) return 0 ;;
  esac
  return 1
}

# One "name|image|status|project|service|config_files|working_dir" line per container publishing $1.
containers_on() {
  command -v docker >/dev/null || return
  docker ps --filter "publish=$1" --format '{{.Names}}|{{.Image}}|{{.Status}}|{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.service"}}|{{.Label "com.docker.compose.project.config_files"}}|{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null
}

# ps etime ([[dd-]hh:]mm:ss) to its largest unit: 14d, 3h, 12m, 40s.
age_of_pid() {
  ps -o etime= -p "$1" | tr -d ' ' | awk -F'[-:]' '
    NF == 4 { print ($1 + 0) "d"; next }
    NF == 3 { print ($1 + 0) "h"; next }
    { print ($1 + 0 ? ($1 + 0) "m" : ($2 + 0) "s") }'
}

# docker status ("Up 6 days (healthy)") to its age: 6d, 1h, 2w.
age_of_status() {
  case "$1" in Up*) ;; *) echo -; return ;; esac
  echo "$1" | sed -E 's/^Up //; s/ \(.*//; s/^(About an?|Less than a) /1 /; s/^([0-9]+) (second|minute|hour|day|week|month|year)s?.*/\1\2/' |
    sed -E 's/second$/s/; s/minute$/m/; s/hour$/h/; s/day$/d/; s/week$/w/; s/month$/mo/; s/year$/y/'
}

# Only states worth acting on; healthy and plain running stay blank.
state_of_status() {
  case "$1" in
    Restarting*) echo restarting ;;
    *unhealthy*) echo unhealthy ;;
    *starting*) echo starting ;;
    Paused*|*Paused*) echo paused ;;
  esac
}

detail() {
  local port=$1 pid=$2 cmd addr script found=0
  addr=$(lsof -w -nP -a -p "$pid" -iTCP:"$port" -sTCP:LISTEN -Fn 2>/dev/null | sed -n 's/^n//p' | sort -u | tr '\n' ' ')
  cmd=$(ps -o command= -p "$pid" | sed 's/[[:space:]]*$//')
  echo "${b}:$port${r}  pid $pid  ${d}$(ps -o user= -p "$pid"), up $(age_of_pid "$pid"), on $addr${r}"
  row command "$cmd"
  if is_docker_forwarder "$cmd"; then
    row via "docker port forward"
    while IFS='|' read -r name image status project service files wd; do
      found=1
      row container "$name  ($image, $status)"
      [ -n "$project" ] && row compose "project $project, service $service"
      row file "$files"
      [ -n "$wd" ] && row repo "$(repo_of "$wd")"
    done < <(containers_on "$port")
    [ $found -eq 0 ] && row docker "no container publishes $port; the VM or daemon itself holds it"
    return
  fi
  locate "$pid"
  script=$(script_of "$cmd")
  if [ -n "$script" ]; then
    case $script in /*) ;; *) script="$CWD/$script" ;; esac
    if [ -e "$script" ]; then
      script="$(cd "$(dirname "$script")" && pwd -P)/$(basename "$script")"
      row script "$script"
    fi
  fi
  row cwd "$CWD"
  [ -n "$LAUNCHER_CWD" ] && [ "$LAUNCHER_CWD" != "$CWD" ] && row from "$LAUNCHER_CWD"
  row repo "$(repo_of "$ORIGIN")"
  row package "$(package_of "$ORIGIN")"
  row launched "$([ $ORPHANED -eq 1 ] && echo "(orphaned: parent exited)  ")$CHAIN"
}

summary() {
  local port=$1 pid=$2 cmd comm who="" where="" pkg up state=""
  cmd=$(ps -o command= -p "$pid" | sed 's/[[:space:]]*$//')
  comm=$(ps -o comm= -p "$pid")
  up=$(age_of_pid "$pid")
  if is_docker_forwarder "$cmd"; then
    while IFS='|' read -r name image status project service files wd; do
      who="${who:+$who, }docker $name"
      [ -z "$project" ] && who="$who ($image)"
      up=$(age_of_status "$status")
      state=$(state_of_status "$status")
      [ -n "$wd" ] && where=$(repo_of "$wd")
      [ -z "$where" ] && [ -n "$project" ] && where="compose $project"
    done < <(containers_on "$port")
    [ -z "$who" ] && who="docker VM (${comm##*/})"
  else
    locate "$pid"
    # Interpreters are named by their script, native programs by their executable.
    case ${comm##*/} in
      node|python*|Python|bun|deno|ruby|java) who=$(short "$cmd" | cut -c1-40) ;;
      *) who=${comm##*/} ;;
    esac
    pkg=$(package_of "$ORIGIN" | cut -d' ' -f1)
    [ -n "$pkg" ] && who="$pkg: $who"
    [ "$ORIGIN" != "/" ] || ORPHANED=0
    [ $ORPHANED -eq 1 ] && state=orphan
    where=$(repo_of "$ORIGIN")
    [ -z "$where" ] && [ "$ORIGIN" != "/" ] && where=$ORIGIN
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$port" "$up" "$state" "$who" "${where/#$HOME/~}"
}

if [ $# -eq 0 ]; then
  lsof -w -nP -iTCP -sTCP:LISTEN -Fpn 2>/dev/null |
    awk '/^p/{pid=substr($0,2)} /^n/{n=split($0,a,":"); print a[n], pid}' |
    sort -n -u -k1,1 -k2,2 |
    while read -r port pid; do summary "$port" "$pid"; done |
    awk -F'\t' -v b="$b" -v d="$d" -v r="$r" '
      { k = $2 FS $3 FS $4 FS $5
        if (!(k in ports)) { order[++n] = k; ports[k] = $1 } else ports[k] = ports[k] "," $1 }
      END {
        w = 5
        for (i = 1; i <= n; i++) if (length(ports[order[i]]) > w) w = length(ports[order[i]])
        printf "%s%-" w "s  %-4s  %-10s  %s%s\n", b, "PORTS", "UP", "STATE", "WHO", r
        for (i = 1; i <= n; i++) { split(order[i], f, FS)
          printf "%-" w "s  %-4s  %-10s  %s  %s%s%s\n", ports[order[i]], f[1], f[2], f[3], d, f[4], r } }'
  exit 0
fi

for port in "$@"; do
  pids=$(lsof -w -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | sort -u)
  if [ -z "$pids" ]; then
    echo "${b}:$port${r}  nothing listening (or owned by another user — try sudo)"
    continue
  fi
  for pid in $pids; do detail "$port" "$pid"; done
done
