# Machine-local environment. Copied to env.local by setup/bootstrap on a fresh
# machine; env.local itself is gitignored and never leaves the box.
#
# Sourced from init.zsh, so anything exported here is available to every shell.

# Work machine? Drives the work-only shell config (.zshrc_work) and the
# work gitconfig created by setup/bootstrap.
# export WORK_ENV=true

# API keys
# export ANTHROPIC_API_KEY=
# export OPENROUTER_API_KEY=
